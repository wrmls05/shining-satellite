---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="landing">
		<section class="hero">
			<span class="eyebrow">Shining Satellite</span>
			<h1>Hello World!</h1>
			<h2>
				Welcome to Astro! Wondering what to do next? Check out the Astro documentation at
				<a href="https://docs.astro.build" target="_blank" rel="noreferrer"> https://docs.astro.build</a>
			</h2>
			<a class="button" href="https://github.com/wrmls05/shining-satellite" target="_blank" rel="noreferrer">Open GitHub</a>
		</section>
	</main>
</Layout>

<style>
	body {
		margin: 0;
		display: grid;
		place-items: center;
		background: #f3f4f6;
		color: #1f2937;
		font-family: 'Segoe UI', Tahoma, sans-serif;
	}

	.landing {
		width: min(100%, 820px);
		padding: 2rem;
	}

	.hero {
		background: #ffffff;
		border: 1px solid #e5e7eb;
		border-radius: 18px;
		padding: 3rem 2rem;
		text-align: center;
	}

	.eyebrow {
		display: inline-block;
		border-radius: 999px;
		background: #eef2ff;
		color: #374151;
		font-weight: 700;
		text-transform: uppercase;
	}

	h1 {
		margin: 1rem 0 0.75rem;
		font-size: 70px;
		line-height: 1.15;
		letter-spacing: -0.04em;
		color: #111827;
	}

	h2 {
		margin: 0 auto 1.5rem;
		max-width: 640px;
		font-size: 1.05rem;
		line-height: 1.7;
		font-weight: 500;
		color: #4b5563;
	}

	a {
		color: #2563eb;
		text-decoration: none;
	}

	.button {
		display: inline-block;
		padding: 0.8rem 1.4rem;
		border-radius: 999px;
		background: #111827;
		color: #ffffff;
		font-weight: 600;
		text-decoration: none;
		transition: opacity 0.2s ease;
	}

	.button:hover {
		opacity: 0.88;
	}
</style>
